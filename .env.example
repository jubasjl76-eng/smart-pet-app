# smart-pet-app — Expo env. Only EXPO_PUBLIC_* reach the app bundle.
# `cp .env.example .env` for local dev.

# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# ── Error tracking (Phase 15) ──────────────────────────────────────────────
# Unset → Sentry is a no-op. The DSN is a public value.
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oNNN.ingest.sentry.io/NNN
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=          # defaults to dev/production
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0  # perf tracing; stays 0 until Phase 16

# CI / EAS build only (source-map upload; never in .env):
#   SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
